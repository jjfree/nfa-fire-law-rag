# NFA source
NFA_CATEGORY_URL=https://law.nfa.gov.tw/MOBILE/category.aspx?typecode=A002
NFA_ALLOWED_HOST=law.nfa.gov.tw
# Single-threaded respectful crawl pacing; increase for stricter networks.
CRAWL_DELAY_SECONDS=2.0
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_RETRIES=3
MAX_ATTACHMENT_BYTES=25000000
MAX_ATTACHMENT_PAGES=200
USER_AGENT=NFA-Fire-Law-RAG/0.1 (+personal research; respectful crawler)
# Optional CSS selector to narrow category links. Empty = heuristic discovery.
CATEGORY_LINK_SELECTOR=
# Optional CSS selector for detail-page main content. Empty = auto-detect.
DETAIL_CONTENT_SELECTOR=
# Prefer the stable GNFA print view when a detail URL contains LSID.
NFA_PREFER_PRINT_VIEW=true

# Storage (default: local SQLite; no Docker, WSL, server, or administrator rights)
STORAGE_BACKEND=sqlite
DATABASE_URL=sqlite:///./data/nfa_fire_law.db
SQLITE_FTS_CANDIDATE_LIMIT=300

# Optional PostgreSQL / pgvector backend:
# STORAGE_BACKEND=postgres
# DATABASE_URL=postgresql+psycopg://nfa:nfa@localhost:5432/nfa_law

# Embedding: hash (no key needed) or openai
EMBEDDING_PROVIDER=hash
EMBEDDING_DIM=384
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Local answer generation (Ollama; retrieval remains available if Ollama is offline)
LLM_PROVIDER=ollama
LLM_BASE_URL=http://127.0.0.1:11434
LLM_CLOUD_BASE_URL=https://ollama.com
LLM_MODEL=gemma4:31b-cloud
LLM_TIMEOUT_SECONDS=180
LLM_TEMPERATURE=0.1
LLM_THINK=false
LLM_MAX_OUTPUT_TOKENS=512

# Optional web fallback. Keep this key local; do not commit it.
WEB_SEARCH_ENABLED=true
WEB_SEARCH_PROVIDER=ollama
OLLAMA_API_KEY=
WEB_SEARCH_API_URL=https://ollama.com/api/web_search
WEB_FETCH_API_URL=https://ollama.com/api/web_fetch
WEB_SEARCH_TIMEOUT_SECONDS=30
WEB_SEARCH_MAX_RESULTS=5
WEB_SEARCH_MAX_FETCH_RESULTS=3
WEB_SEARCH_MIN_HYBRID_SCORE=0.30
WEB_SEARCH_ALLOWED_DOMAINS=law.nfa.gov.tw,nfa.gov.tw,law.moj.gov.tw,gazette.nat.gov.tw,web.law.ntpc.gov.tw,laws.gov.taipei

# Search
HYBRID_VECTOR_WEIGHT=0.72
DEFAULT_TOP_K=8

# API
API_HOST=0.0.0.0
API_PORT=8000
